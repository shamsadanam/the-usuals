{
  "name": "the-usuals",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:(docs|next|nuxt)$/\"",
    "dev:docs": "pnpm --filter docs run dev --port 3002",
    "dev:next": "pnpm --filter example-next run dev --port 3000",
    "dev:nuxt": "pnpm --filter example-nuxt run dev --port 3001",
    "build": "pnpm -r run build",
    "build:docs": "pnpm --filter docs run build",
    "build:next": "pnpm --filter example-next run build",
    "build:nuxt": "pnpm --filter example-nuxt run build",
    "start:next": "pnpm --filter example-next run start --port 3000",
    "generate:docs": "pnpm --filter docs run generate",
    "preview:docs": "pnpm --filter docs run preview --port 3002",
    "preview:nuxt": "pnpm --filter example-nuxt run preview --port 3001",
    "lint:next": "pnpm --filter example-next run lint",
    "clean": "rm -rf node_modules docs/node_modules docs/.nuxt docs/.output docs/.data examples/*/node_modules examples/*/.next examples/*/.nuxt examples/*/.output"
  }
}
